function getApiKey(): string {
  const apiKey = String(vendor.inputValues.apiKey ?? "").replace(/^Bearer\s+/i, "").trim();
  if (!apiKey) throw new Error("佳速 API 尚未填写 API 密钥");
  return apiKey;
}

function getBaseUrl(): string {
  const configured = String(vendor.inputValues.baseUrl ?? "").trim().replace(/\/+$/, "");
  // 旧账号或云端同步回来的旧官方地址自动切换；显式私有代理保持不变。
  if (/^https:\/\/js\.jiasuapi\.com(?:\/v1)?$/i.test(configured)) return PRODUCTION_BASE_URL;
  return configured || PRODUCTION_BASE_URL;
}

function stringValue(value: unknown): string {
  return typeof value === "string" ? value.trim() : "";
}

function safeReason(value: unknown, fallback: string): string {
  const message = stringValue(value) || fallback;
  const key = String(vendor.inputValues.apiKey ?? "").trim().replace(/^Bearer\s+/i, "");
  // 供应商错误字段也不可信：移除密钥、Bearer 和内联素材后才进入任务诊断。
  return (key ? message.split(key).join("[REDACTED_SECRET]") : message)
    .replace(/Bearer\s+[^\s;,]+/gi, "Bearer [REDACTED_SECRET]")
    .replace(/data:[^\s;,]+;base64,[a-z0-9+/=]+/gi, "[REDACTED_MEDIA]")
    .slice(0, 1000);
}

function safeApiError(prefix: string, status: number, payload: ApiErrorPayload): Error {
  const parts = [`${prefix}：HTTP ${status}`];
  const requestId = stringValue(payload?.request_id);
  const code = stringValue(payload?.error?.code);
  const message = stringValue(payload?.error?.message);
  const retryable = payload?.error?.retryable === true;
  const retryAfter = Number(payload?.error?.retry_after_seconds);
  if (requestId) parts.push(`请求ID ${requestId}`);
  if (code) parts.push(`错误码 ${code}`);
  if (code === "EDGE_CONTROL_UNAVAILABLE") {
    parts.push("佳速 API 控制面暂不可用");
  } else if (message) {
    parts.push(message);
  }
  if (retryable) {
    parts.push(Number.isFinite(retryAfter) && retryAfter > 0
      ? `请在 ${Math.ceil(retryAfter)} 秒后手动重试`
      : "请稍后手动重试");
  }
  // 不拼接原始响应体，避免密钥、素材或供应商内部信息进入错误日志。
  const error = new Error(safeReason(parts.join("；"), prefix)) as Error & { httpStatus?: number };
  error.httpStatus = status;
  return error;
}

async function parseJsonResponse(response: any): Promise<Record<string, any>> {
  try {
    const value = await response.json();
    return value && typeof value === "object" ? value : {};
  } catch {
    return {};
  }
}

async function requestJson(
  path: string,
  init: Record<string, unknown>,
  errorPrefix: string,
): Promise<Record<string, any>> {
  const response = await fetch(`${getBaseUrl()}${path}`, init);
  const payload = await parseJsonResponse(response);
  if (!response.ok) throw safeApiError(errorPrefix, Number(response.status), payload);
  return payload;
}

function httpsUrl(value: unknown): string {
  const url = stringValue(value);
  try {
    const parsed = new URL(url);
    return parsed.protocol === "https:" && !parsed.username && !parsed.password ? url : "";
  } catch { return ""; }
}

function createdTaskId(payload: Record<string, any>): string {
  // 顶层 id/task_id 是公开任务 ID；查询 DTO 的 data.id 是数据库记录号，绝不使用。
  const id = stringValue(payload.task_id) || stringValue(payload.id);
  if (!id) throw new Error("生成请求响应缺少公开任务 ID，请查看任务中心，勿重复提交");
  return id;
}

const textRequest = (model: TextModel) => {
  // 文本模型统一走 OpenAI 兼容接口，模型名称仅原样透传。
  return createOpenAI({ baseURL: getBaseUrl(), apiKey: getApiKey() }).chat(model.modelName);
};

async function imageRequest(config: ImageConfig, model: ImageModel): Promise<string> {
  const images = referenceValues(config.referenceList ?? [], "image");
  const body: Record<string, unknown> = {
    model: model.modelName,
    prompt: config.prompt,
    ratio: config.aspectRatio,
    resolution: String(config.size).toLowerCase(),
  };
  if (images.length) body.images = images;

  const payload = await requestJson(
    "/images/create",
    {
      method: "POST",
      headers: {
        Authorization: `Bearer ${getApiKey()}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify(body),
    },
    "图片生成请求失败",
  );
  return waitForTask(createdTaskId(payload), "image");
}

function referenceValues(references: ReferenceItem[], type: ReferenceItem["type"]): string[] {
  // 新协议数组仅接受 URL；素材转换由宿主暂存阶段完成，禁止把 Base64 塞进数组收费提交。
  return references
    .filter((reference) => reference.type === type)
    .map((reference) => {
      const url = httpsUrl(reference.base64);
      if (!url) throw new Error("参考素材必须先暂存为不含账号凭据的 HTTPS URL");
      return url;
    });
}

function getUpdateBaseUrl(): string {
  // updateBaseUrl 不展示在凭据表单中，仅供本地合同测试或受控部署覆盖。
  return String(vendor.inputValues.updateBaseUrl || PROVIDER_UPDATE_BASE_URL)
    .trim()
    .replace(/\/+$/, "");
}

function taskKind(context?: TaskContext): TaskKind {
  const hint = context?.remoteStatusHint || "";
  if (/\/images?\//.test(hint)) return "image";
  if (/\/videos?\//.test(hint)) return "video";
  // 无创建路径的历史任务按已持久化业务类型判断；旧单参数 queryTask 默认仍为视频。
  return /图|image/i.test(context?.taskClass || "") ? "image" : "video";
}

function normalizeTask(payload: Record<string, any>, kind: TaskKind): TaskResult {
  if (kind === "image" && payload.code !== "success") {
    return { state: "temporary_error", reason: safeReason(payload.message, "图片任务查询回执无效") };
  }
  const task = kind === "image" ? payload.data : payload;
  if (!task || typeof task !== "object" || Array.isArray(task)) {
    return { state: "temporary_error", reason: "任务查询响应格式无效" };
  }
  const status = stringValue(task.status).toLowerCase();
  if (status === "failure" || status === "failed") {
    return { state: "failed", reason: safeReason(kind === "image" ? task.fail_reason : task.error?.message, "生成任务失败") };
  }
  if (status === (kind === "image" ? "success" : "completed")) {
    const url = kind === "image"
      ? httpsUrl(task.result_url)
      : Array.isArray(task.result_urls) ? task.result_urls.map(httpsUrl).find(Boolean) : "";
    // 完成但结果不完整只允许继续查询原任务，禁止读已废弃 url 或重新创建。
    return url ? { state: "completed", url, output: { url }, artifact: { mediaType: kind, sourceKind: "remote_url", remoteUrl: url } }
      : { state: "temporary_error", reason: "任务已完成，但查询响应缺少有效结果 URL" };
  }
  const pending = kind === "image"
    ? ["not_start", "submitted", "queued", "in_progress", "unknown"]
    : ["queued", "in_progress", "unknown"];
  return pending.includes(status) ? { state: "pending" }
    : { state: "temporary_error", reason: "任务查询响应缺少有效状态" };
}

async function videoRequest(config: VideoConfig, model: VideoModel): Promise<string> {
  const references = config.referenceList ?? [];
  const images = referenceValues(references, "image");
  const videos = referenceValues(references, "video");
  const audios = referenceValues(references, "audio");
  const body: Record<string, unknown> = {
    model: model.modelName,
    prompt: config.prompt,
    duration: config.duration,
    ratio: config.aspectRatio,
    resolution: config.resolution,
  };
  // 首尾帧模式显式标注方向；多参考模式仍用 images，模型名称不参与路由分支。
  // 旧工作台直接传模式字符串，新画布可能传单元素数组，两种入口必须保持首尾帧方向一致。
  const mode = typeof config.mode === "string" ? config.mode
    : config.mode?.length === 1 ? config.mode[0] : undefined;
  if (mode === "startEndRequired" || mode === "endFrameOptional" || mode === "startFrameOptional") {
    if (images.length > 2 || images.length < (mode === "startEndRequired" ? 2 : 1)) {
      throw new Error("首尾帧参考图数量与当前模式不匹配");
    }
    if (mode === "startFrameOptional" && images.length === 1) body.end_frame_url = images[0];
    else {
      body.first_frame_url = images[0];
      if (images[1]) body.end_frame_url = images[1];
    }
  } else if (mode === "singleImage" && images.length === 1) body.image = images[0];
  else if (images.length > 0) body.images = images;
  if (videos.length > 0) body.videos = videos;
  if (audios.length > 0) body.audios = audios;
  if (stringValue(config.channel)) body.channel = config.channel;
  if (stringValue(config.function_mode)) body.function_mode = config.function_mode;

  const created = await requestJson(
    "/video/generations",
    {
      method: "POST",
      headers: {
        Authorization: `Bearer ${getApiKey()}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify(body),
    },
    "视频生成请求失败",
  );
  return waitForTask(createdTaskId(created), "video");
}

async function queryTask(remoteTaskId: string, context?: TaskContext): Promise<TaskResult> {
  const kind = taskKind(context);
  try {
    const payload = await requestJson(`/${kind === "image" ? "images" : "videos"}/tasks/${encodeURIComponent(remoteTaskId)}`, {
      method: "GET", headers: { Authorization: `Bearer ${getApiKey()}` },
    }, "生成任务查询失败");
    return normalizeTask(payload, kind);
  } catch (error) {
    const status = Number((error as { httpStatus?: unknown } | undefined)?.httpStatus);
    if (status === 404) return { state: "not_found", reason: "远端任务不存在" };
    if (status === 410) return { state: "failed", reason: "任务已结束或媒体已过保留期" };
    return { state: "temporary_error", reason: safeReason((error as Error)?.message, "生成任务查询暂不可用") };
  }
}

async function waitForTask(remoteTaskId: string, kind: TaskKind): Promise<string> {
  const context = { remoteStatusHint: kind === "image" ? "/v1/images/create" : "/v1/video/generations" };
  const result = await pollTask(async () => {
    const task = await queryTask(remoteTaskId, context);
    if (task.state === "completed") return { completed: true, data: task.url };
    if (task.state === "pending") return { completed: false };
    return { completed: false, error: task.reason || "任务查询失败" };
  });
  if (result.error) throw new Error(`生成任务未完成：${result.error}`);
  if (!result.completed || !result.data) throw new Error("生成任务未返回结果 URL");
  return result.data;
}

async function ttsRequest(): Promise<string> {
  throw new Error("佳速 API 当前模板未配置音频模型");
}

async function listModels(): Promise<RemoteModel[]> {
  const payload = await requestJson(
    "/models",
    {
      method: "GET",
      headers: { Authorization: `Bearer ${getApiKey()}` },
    },
    "获取模型列表失败",
  );
  const source = Array.isArray(payload.data) ? payload.data : [];
  const seen = new Set<string>();
  const models: RemoteModel[] = [];
  for (const item of source) {
    const id = stringValue(item?.id);
    if (!id || seen.has(id)) continue;
    seen.add(id);
    const model: RemoteModel = { id };
    if (typeof item?.object === "string") model.object = item.object;
    if (typeof item?.created === "number") model.created = item.created;
    if (typeof item?.owned_by === "string") model.owned_by = item.owned_by;
    models.push(model);
  }
  return models;
}

async function checkForUpdates() {
  const manifest = await requestProviderManifest();
  return {
    hasUpdate: compareVersions(manifest.version, vendor.version) > 0,
    latestVersion: manifest.version,
    notice: stringValue(manifest.notice) || `佳速 API 配置 ${manifest.version} 已发布`,
  };
}

async function updateVendor() {
  const manifest = await requestProviderManifest();
  if (compareVersions(manifest.version, vendor.version) <= 0) {
    throw new Error("当前佳速 API 配置已是最新版本");
  }
  const expectedPath = `provider-configs/tianjiang/releases/${manifest.version}/tianjiang.ts`;
  if (manifest.sourcePath !== expectedPath) throw new Error("佳速配置源码路径校验失败");
  const response = await fetch(
    `${getUpdateBaseUrl()}/releases/${encodeURIComponent(manifest.version)}/source`,
    { method: "GET" },
  );
  if (!response.ok) throw new Error(`下载佳速配置源码失败：HTTP ${Number(response.status)}`);
  const source = String(await response.text());
  if (utf8ByteLength(source) !== manifest.size) throw new Error("佳速配置源码大小校验失败");
  const actualSha256 = crypto.createHash("sha256").update(source, "utf8").digest("hex");
  if (actualSha256.toLowerCase() !== manifest.sha256.toLowerCase()) {
    throw new Error("佳速配置源码 SHA-256 校验失败");
  }
  if (!/\bid\s*:\s*["']tianjiang["']/.test(source)
    || !new RegExp(`\\bversion\\s*:\\s*["']${escapeRegExp(manifest.version)}["']`).test(source)) {
    throw new Error("佳速配置源码身份校验失败");
  }
  return source;
}

function compareVersions(left: string, right: string): number {
  const parse = (value: string) => value.split(".").map((part) => Number(part));
  const a = parse(left);
  const b = parse(right);
  if (a.some((part) => !Number.isInteger(part) || part < 0)
    || b.some((part) => !Number.isInteger(part) || part < 0)) {
    throw new Error("佳速配置版本格式无效");
  }
  const length = Math.max(a.length, b.length);
  for (let index = 0; index < length; index += 1) {
    const difference = (a[index] ?? 0) - (b[index] ?? 0);
    if (difference !== 0) return difference > 0 ? 1 : -1;
  }
  return 0;
}

function utf8ByteLength(value: string): number {
  // 模板沙盒不依赖 Buffer/TextEncoder，用 URI 编码稳定计算 UTF-8 字节数。
  return unescape(encodeURIComponent(value)).length;
}

function escapeRegExp(value: string): string {
  return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

async function requestProviderManifest(): Promise<ProviderSourceManifest> {
  const response = await fetch(`${getUpdateBaseUrl()}/latest`, { method: "GET" });
  if (!response.ok) throw new Error(`检查佳速配置更新失败：HTTP ${Number(response.status)}`);
  const envelope = await parseJsonResponse(response);
  if (Number(envelope.code) !== 0 || !envelope.data || typeof envelope.data !== "object") {
    throw new Error("佳速配置更新清单响应无效");
  }
  const manifest = envelope.data as ProviderSourceManifest;
  if (manifest.schemaVersion !== 1
    || manifest.providerId !== "tianjiang"
    || !/^\d+(?:\.\d+){1,3}$/.test(stringValue(manifest.version))
    || !/^[0-9a-f]{64}$/i.test(stringValue(manifest.sha256))
    || !Number.isInteger(manifest.size)
    || manifest.size <= 0) {
    throw new Error("佳速配置更新清单完整性校验失败");
  }
  return manifest;
}

