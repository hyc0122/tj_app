      "@tapcanvas/storyboard-director-protocol": ["tap-packages/packages/storyboard-director-protocol/index.ts"],
      "@tapcanvas/storyboard-selection-protocol": ["tap-packages/packages/storyboard-selection-protocol/index.ts"],
      "@tapcanvas/storyboard-adventure-protocol": ["tap-packages/packages/storyboard-adventure-protocol/index.ts"],
